def configured_path(config_path: Path, config: dict[str, object], key: str) -> Path:
    value = config.get(key)
    if not isinstance(value, str) or not value:
        raise RouterError(f"missing config path: {key}")
    return resolve_path(config_path, value)


def validate_runtime(config_path: Path, config: dict[str, object]) -> dict[str, Path]:
    path_keys = [
        "native_cgpdftoraster",
        "dispatcher_python",
        "dispatcher",
        "dispatcher_runtime_root",
        "dispatcher_ghostscript",
        "dispatcher_ghostscript_lib",
        "baseline_raster_ppd",
    ]
    generic_enabled = bool(config.get("generic_600_enabled", False))
    generic_1200_enabled = bool(config.get("generic_1200_enabled", False))

    def disable_generic(reason: str) -> None:
        """Keep a bad optional adapter from blocking the native route."""
        nonlocal generic_enabled
        generic_enabled = False
        config["generic_600_enabled"] = False
        config["generic_600_disabled_reason"] = reason
        emit("GENERIC_DISABLED_NATIVE_FALLBACK", reason=reason)

    def disable_generic_1200(reason: str) -> None:
        """Keep the optional 1200 enhancement fail-closed to native."""
        nonlocal generic_1200_enabled
        generic_1200_enabled = False
        config["generic_1200_enabled"] = False
        config["generic_1200_disabled_reason"] = reason
        emit("GENERIC_1200_DISABLED_NATIVE_FALLBACK", reason=reason)

    # The generic renderer is an optional 600 dpi enhancement.  A missing or
    # malformed adapter must therefore disable only that enhancement and let
    # the established native path continue.
    generic_value = config.get("generic_600_adapter")
    if generic_enabled and (not isinstance(generic_value, str) or not generic_value):
        disable_generic("generic_600_adapter is missing from config")
    if generic_enabled:
        path_keys.append("generic_600_adapter")
    generic_1200_value = config.get("generic_1200_adapter")
    if generic_1200_enabled and (not isinstance(generic_1200_value, str) or not generic_1200_value):
        disable_generic_1200("generic_1200_adapter is missing from config")
    if generic_1200_enabled:
        path_keys.append("generic_1200_adapter")
    paths = {key: configured_path(config_path, config, key) for key in path_keys}
    files = (
        "native_cgpdftoraster",
        "dispatcher_python",
        "dispatcher",
        "dispatcher_ghostscript",
        "baseline_raster_ppd",
    )
    for key in files:
        if not paths[key].is_file():
            raise RouterError(f"configured file is missing: {key}={paths[key]}")
    if generic_enabled and not paths["generic_600_adapter"].is_file():
        disable_generic(
            "configured file is missing: generic_600_adapter="
            f"{paths['generic_600_adapter']}"
        )
    if generic_1200_enabled and not paths["generic_1200_adapter"].is_file():
        disable_generic_1200(
            "configured file is missing: generic_1200_adapter="
            f"{paths['generic_1200_adapter']}"
        )
    if not paths["baseline_raster_ppd"].is_file() or not os.access(paths["baseline_raster_ppd"], os.R_OK):
        raise RouterError("baseline PPD is not a readable regular file")
    for key in ("native_cgpdftoraster", "dispatcher_python", "dispatcher_ghostscript"):
        if not os.access(paths[key], os.X_OK):
            raise RouterError(f"configured executable is not executable: {key}={paths[key]}")
    for key in ("dispatcher_runtime_root", "dispatcher_ghostscript_lib"):
        if not paths[key].is_dir():
            raise RouterError(f"configured directory is missing: {key}={paths[key]}")

    if config.get("enforce_hashes", False):
        expected = config.get("sha256")
        if not isinstance(expected, dict):
            raise RouterError("hash enforcement is enabled without sha256 pins")
        if not config.get("_builtin"):
            own_expected = expected.get("smart_router")
            own_actual = sha256_file(Path(__file__).resolve())
            if not isinstance(own_expected, str) or own_actual != own_expected:
                raise RouterError(
                    f"hash mismatch: smart_router expected={own_expected} actual={own_actual}"
                )
        for key in ("native_cgpdftoraster", "dispatcher", "dispatcher_ghostscript", "baseline_raster_ppd"):
            wanted = expected.get(key)
            actual = sha256_file(paths[key])
            if not isinstance(wanted, str) or actual != wanted:
                raise RouterError(f"hash mismatch: {key} expected={wanted} actual={actual}")
        if generic_enabled:
            wanted = expected.get("generic_600_adapter")
            try:
                actual = sha256_file(paths["generic_600_adapter"])
            except OSError as exc:
                disable_generic(f"cannot hash generic_600_adapter: {exc}")
            else:
                if not isinstance(wanted, str) or actual != wanted:
                    disable_generic(
                        "hash mismatch: generic_600_adapter "
                        f"expected={wanted} actual={actual}"
                    )
        if generic_1200_enabled:
            wanted = expected.get("generic_1200_adapter")
            try:
                actual = sha256_file(paths["generic_1200_adapter"])
            except OSError as exc:
                disable_generic_1200(f"cannot hash generic_1200_adapter: {exc}")
            else:
                if not isinstance(wanted, str) or actual != wanted:
                    disable_generic_1200(
                        "hash mismatch: generic_1200_adapter "
                        f"expected={wanted} actual={actual}"
                    )
    return paths


def load_generic_adapter(path: Path):
    """Load the pinned generic adapter without importing development modules."""
    spec = importlib.util.spec_from_file_location("hp116w_generic_600", path)
    if spec is None or spec.loader is None:
        raise RouterError(f"cannot load generic adapter: {path}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    for name in ("pdf_features", "classify_pdf", "render_generic"):
        if not callable(getattr(module, name, None)):
            raise RouterError(f"generic adapter missing callable: {name}")
    return module


def six_hundred_request(filter_args: list[str]) -> tuple[bool, str]:
    """Gate generic opt-in to the named 600 dpi fixed queue only."""
    queue = os.environ.get("PRINTER", "").strip()
    if queue != "HP116W_600dpi":
        return False, f"queue={queue or 'unset'} is not HP116W_600dpi"
    if len(filter_args) < 5:
        return False, "missing CUPS options"
    options = filter_args[4] or ""
    explicit: list[tuple[str, int]] = []
    for raw in re.split(r"[\s,]+", options.strip()):
        if not raw or "=" not in raw:
            continue
        name, token = raw.split("=", 1)
        key = name.lower()
        if key not in {"resolution", "quality", "cupsprintquality"}:
            continue
        token = token.strip().strip('"').lower()
        if key == "cupsprintquality":
            if token == "normal":
                dpi = 600
            elif token == "high":
                dpi = 1200
            else:
                match = re.fullmatch(r"([0-9]+)(?:x[0-9]+)?(?:dpi)?", token)
                if not match:
                    return False, f"unsupported explicit quality={token}"
                dpi = int(match.group(1))
        else:
            if token in {"normal", "standard"}:
                dpi = 600
            elif token in {"high", "best"}:
                dpi = 1200
            else:
                match = re.fullmatch(r"([0-9]+)(?:x[0-9]+)?(?:dpi)?", token)
                if not match:
                    return False, f"unsupported explicit {name}={token}"
                dpi = int(match.group(1))
        explicit.append((name, dpi))
    if explicit and ({dpi for _, dpi in explicit} != {600}):
        return False, f"explicit resolution conflict={explicit}"
    return True, "fixed queue and explicit options resolve to 600dpi"


