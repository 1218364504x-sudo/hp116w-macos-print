    # router and PPD).  Do not make that install depend on a fourth JSON file:
    # use a pinned production configuration when the filter is running from
    # CUPS' allow-listed directory.  Offline tests pass an explicit fixture.
    if not config_path.is_file() and (
        os.environ.get("HP116W_SMART_INSTALLED") == "1"
        or SCRIPT_DIR == INSTALLED_FILTER_DIR
    ):
        return Path("/usr/libexec/cups/filter/hp116w_smart_router"), {
            "schema": 1,
            "profile": "production",
            "_builtin": True,
