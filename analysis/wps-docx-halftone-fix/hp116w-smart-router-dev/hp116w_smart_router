#!/usr/bin/python3
"""Fail-closed CUPS PDF router for the HP116W smart queue.

The router accepts the standard CUPS filter arguments, classifies the complete
PDF, and produces one complete CUPS Raster stream on stdout.  It never writes
diagnostics to stdout and never invokes a device encoder or backend.
"""
from __future__ import annotations

import datetime as dt
import hashlib
import importlib.util
import json
import os
import re
import signal
import struct
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import BinaryIO


SCRIPT_DIR = Path(__file__).resolve().parent
DEFAULT_CONFIG = SCRIPT_DIR / "smart-router-config.json"
INSTALLED_FILTER_DIR = Path("/usr/libexec/cups/filter")
RASTER_MAGICS = {b"RaSt", b"tSaR", b"RaS2", b"2SaR", b"RaS3", b"3SaR"}
GRAY_TOKEN = b"0.9098039 0.9098039 0.9098039 sc"
SAFE_JOB = re.compile(r"[^A-Za-z0-9_.-]+")
SUPPORTED_MEDIA_POINTS = ((612.0, 792.0), (595.0, 842.0))
MEDIA_TOLERANCE_PT = 1.0


class RouterError(RuntimeError):
    """Expected fail-closed router error."""


class RouterTimeout(RouterError):
    """A child filter exceeded its bounded runtime."""


class RouterInterrupted(RouterError):
    """The scheduler or operator interrupted the router."""

    def __init__(self, signum: int):
        super().__init__(f"interrupted by signal {signum}")
        self.signum = signum


def emit(event: str, **fields: object) -> None:
    record = {
        "timestamp": dt.datetime.now(dt.timezone.utc).isoformat(timespec="milliseconds"),
        "event": event,
        **fields,
    }
    print("HP116W_SMART " + json.dumps(record, ensure_ascii=False, default=str),
          file=sys.stderr, flush=True)


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def supported_media(width: float, height: float) -> bool:
    return any(
        abs(width - media_width) <= MEDIA_TOLERANCE_PT
        and abs(height - media_height) <= MEDIA_TOLERANCE_PT
        for media_width, media_height in SUPPORTED_MEDIA_POINTS
    )


def resolve_path(config_path: Path, value: str) -> Path:
    path = Path(value)
    if not path.is_absolute():
        path = config_path.parent / path
    return path.resolve()


