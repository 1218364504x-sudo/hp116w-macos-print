            "dispatcher_ghostscript": "/usr/libexec/cups/filter/hp116w_gs",
            "dispatcher_ghostscript_lib": "/usr/libexec/cups/filter/hp116w_gs_resources/share/ghostscript",
            "baseline_raster_ppd": "/Library/Application Support/HP116W/baseline/HP116W_High_Quality_NATIVE.ppd",
            "generic_600_enabled": True,
            "generic_600_adapter": "/Library/Application Support/HP116W/runtime/hp116w_generic_600.py",
            "generic_1200_enabled": True,
