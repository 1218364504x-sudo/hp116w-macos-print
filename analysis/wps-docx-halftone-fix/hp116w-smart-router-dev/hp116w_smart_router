            "sha256": {
                "native_cgpdftoraster": "7b0ab7ad0a10119123bbf47addb04801f896d494959632a27b22b86a68a1ff2b",
                "dispatcher": "41f485968999d33d148c0e0edb7e11d303cb484d730cd54e84b731d8601d53c8",
